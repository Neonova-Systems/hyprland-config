#!/usr/bin/env bash
set -euo pipefail

# Focus a running kitty window, switching workspace if needed.
# If kitty is already focused, run the project sessionizer in a new tab.
# If none is running, launch kitty and run the sessionizer in it.
#
# Override the sessionizer target with KITTY_SESSIONIZER=<path>.
# Override the window class with KITTY_CLASS=<regex>.

if ! command -v hyprctl >/dev/null 2>&1; then
    echo "hyprctl not found" >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "jq not found" >&2
    exit 1
fi

kitty_class="${KITTY_CLASS:-^kitty$}"
sessionizer="${KITTY_SESSIONIZER:-$HOME/.config/kitty/kitty-sessionizer}"

# Command to open a sessionizer window/tab. Empty when the sessionizer is
# missing, so kitty falls back to a plain shell.
launch_cmd=()
if [[ -x "$sessionizer" ]]; then
    launch_cmd=("$sessionizer")
fi

open_window() {
    if ((${#launch_cmd[@]})); then
        exec kitty -e "${launch_cmd[@]}"
    fi
    exec kitty
}

# The picker needs a TTY, so the sessionizer always runs inside a kitty window.
# Prefer a new tab in the focused kitty; that needs the instance to expose a
# remote control socket (`listen_on` in kitty.conf).
open_tab() {
    local pid="$1" listen_on=""

    # KITTY_LISTEN_ON is only exported to kitty's children, and Hyprland reports
    # the kitty process pid, so fall back to the `unix:@kitty-<pid>` template
    # used by `listen_on unix:@kitty-{kitty_pid}` in kitty.conf.
    if [[ -r "/proc/$pid/environ" ]]; then
        listen_on=$(tr '\0' '\n' < "/proc/$pid/environ" \
            | sed -n 's/^KITTY_LISTEN_ON=//p' \
            | head -n 1 || true)
    fi
    if [[ -z "$listen_on" && "$pid" != 0 ]]; then
        listen_on="unix:@kitty-$pid"
    fi

    if [[ -n "$listen_on" ]] && command -v kitten >/dev/null 2>&1 \
        && kitten @ --to "$listen_on" ls >/dev/null 2>&1; then
        if ((${#launch_cmd[@]})); then
            exec kitten @ --to "$listen_on" launch --type=tab "${launch_cmd[@]}"
        fi
        exec kitten @ --to "$listen_on" launch --type=tab
    fi

    open_window
}

# Already focused on kitty: cycle projects instead of a no-op focus.
active=$(hyprctl activewindow -j)
if jq -e --arg re "$kitty_class" '(.class // "") | test($re; "i")' <<<"$active" >/dev/null; then
    open_tab "$(jq -r '.pid // 0' <<<"$active")"
fi

# Focus by address: works across workspaces and avoids regex parsing quirks.
address=$(hyprctl clients -j \
    | jq -r --arg re "$kitty_class" '.[] | select((.class // "") | test($re; "i")) | .address' \
    | head -n1)

if [[ -n "$address" ]]; then
    # Dispatch with the Lua form: this Hyprland parses `hyprctl dispatch` as Lua,
    # so the legacy `focuswindow class:...` argument form fails.
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
    exit 0
fi

if ! command -v kitty >/dev/null 2>&1; then
    echo "kitty not found" >&2
    exit 1
fi

open_window
